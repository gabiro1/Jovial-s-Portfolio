# Server
PORT=5000

# MongoDB connection string.
# Local development:
MONGODB_URI=mongodb://localhost:27017/portfolio
# Production: use a MongoDB Atlas connection string, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret used to sign admin JWT tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created on first server start (if it does not exist).
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-me
